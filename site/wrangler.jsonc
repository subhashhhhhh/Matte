{
  // The site is static files (Astro builds them into ./dist). Cloudflare's build runs
  // `npm run build` here and serves ./dist; the pages read ../docs at build time.
  "name": "matte",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
