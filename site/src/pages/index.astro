---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Command from '../components/Command.astro';
import Wordmark from '../components/Wordmark.astro';
import { brew } from '../data';

const reasons = [
  {
    title: 'Easy on your Mac',
    text: 'instagram.com in a browser often takes 4⁠–⁠5 GB of memory. Matte takes a fraction of that, so the rest of your Mac stays quick.',
    icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    title: 'Your phone can stay in your pocket',
    text: 'Messages, stories and Reels on the screen you’re already looking at, with a real keyboard to reply.',
    icon: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  },
  {
    title: 'Feels like a Mac app',
    text: 'Swipe carousels with the trackpad, double-click to like, and get notifications like any other app.',
    icon: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM2 20h20',
  },
];

const ghost = [
  ['Watch stories without “Seen”', 'Your name stays off the viewer list'],
  ['Read messages without “Seen”', 'The chat stays unread for the sender'],
  ['Type without “typing…”', 'Nobody sees you writing a reply'],
];

const more = [
  ['Post from your Mac', 'Photos, carousels and reels, and a story editor with text, drawing, stickers, filters and music'],
  ['Every account in one window', 'Add your other accounts and switch between them in a click'],
  ['Saved posts and collections', 'Everything you saved, laid out to browse'],
  ['Explore and search', 'People, tags and places, with your recent searches kept'],
  ['Light and dark', 'Follows your Mac’s appearance'],
  ['Free', 'No ads, no subscription, no account with us. The code is open for anyone to read'],
];
---

<Base
  title="Matte — Instagram for your Mac"
  description="Matte is a free Mac app for Instagram. Your feed, Reels, stories and DMs on the big screen, in an app that won’t slow your computer down."
>
  <main>
    <section class="hero" data-hero>
      <div class="wrap center" data-hero-text>
        <h1 data-hero-title>Your Instagram,<br />on the big screen</h1>
        <p class="lede" data-hero-fade>Feed, Reels, stories and DMs in a Mac app that won’t slow your computer down.</p>
        <div class="ctas" data-hero-fade>
          <a class="btn btn-primary" href="/download">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.37 12.73c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.41-3.65zM14.1 5.98c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.75-.96 2.79 1.02.08 2.05-.52 2.68-1.27z"></path></svg>
            Download for Mac
          </a>
          <Command command={brew} />
        </div>
        <p class="meta" data-hero-fade>Free · macOS 15 or later · Apple silicon and Intel</p>
        <p class="phone-note" data-hero-fade>Matte runs on Macs: open this page on your Mac to download it.</p>
      </div>
      <div class="wrap hero-shot" data-hero-window>
        <div class="crop" style="--w:150;--x:37.5;--y:0;--ar:1.06">
        <Shot name="home" eager hero alt="Matte’s home feed: posts in three columns, stories down the side, a reel playing in the corner and a message arriving" />
        </div>
      </div>
    </section>

    <section class="reasons wrap" aria-label="Why Matte">
      {reasons.map((r) => (
        <div class="reason" data-reveal>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={r.icon}></path></svg>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </div>
      ))}
    </section>

    <div id="features"></div>

    <section class="feature wrap">
      <div class="copy" data-reveal>
        <p class="label">Messages</p>
        <h2 data-title>Answer DMs without reaching for your phone</h2>
        <p class="lede">Messages pop up on your Mac while you work. Reply with a real keyboard, send photos and videos straight from your computer, and keep the chats that matter pinned at the top.</p>
      </div>
      <div class="media crop" data-rise style="--w:167;--x:55;--y:3.8;--ar:1">
        <Shot name="messages" alt="A conversation in Matte with a shared reel, a voice note and a reaction, and a new message notification" />
      </div>
    </section>

    <section class="feature flip wrap" data-pip-section>
      <div class="copy" data-reveal>
        <p class="label">Reels</p>
        <h2 data-title>Reels on a screen big enough to enjoy them</h2>
        <p class="lede">Watch with the comments right beside the video. Go check something else and the reel keeps playing in the corner.</p>
      </div>
      <div class="media crop" style="--w:150;--x:40.5;--y:9.2;--ar:1.18">
        <!-- The reel leaves its place in the Reels window for the corner while Home comes to the
             front (site.ts). The layers are the same size, so they stack exactly. -->
        <div class="pip" data-pip-scene>
          <img class="only-dark" src="/shots/reels-dark.webp" alt="A reel in Matte with its comments beside it; scrolling on, it moves to the corner and keeps playing over the home feed" width="1440" height="1100" loading="lazy" decoding="async" />
          <img class="only-light" src="/shots/reels-light.webp" alt="A reel in Matte with its comments beside it; scrolling on, it moves to the corner and keeps playing over the home feed" width="1440" height="1100" loading="lazy" decoding="async" />
          <div class="pip-other" data-pip-other aria-hidden="true">
            <img class="only-dark" src="/shots/pip-home-dark.webp" alt="" width="1440" height="1100" loading="lazy" decoding="async" />
            <img class="only-light" src="/shots/pip-home-light.webp" alt="" width="1440" height="1100" loading="lazy" decoding="async" />
          </div>
          <i class="pip-slot" data-pip-slot aria-hidden="true"></i>
          <div class="pip-reel" data-pip-reel aria-hidden="true">
            <img src="/shots/reel.webp" alt="" width="384" height="683" loading="lazy" decoding="async" />
            <span class="pip-bar"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="feature wrap">
      <div class="copy" data-reveal>
        <p class="label">For business and creator accounts</p>
        <h2 data-title>Post on time, even on your busiest days</h2>
        <p class="lede">Line up a month of posts and reels, and Instagram publishes each one on time, even with your Mac closed. Then answer every comment still waiting for you, from one list.</p>
      </div>
      <div class="media crop" data-rise style="--w:210;--x:31.5;--y:20.9;--ar:1.27">
        <Shot name="planner" alt="Matte’s planner: a month of scheduled posts and reels, with the upcoming ones listed beside it" />
      </div>
    </section>

    <section class="ghost wrap">
      <div class="copy" data-reveal>
        <p class="label">Ghost mode</p>
        <h2 data-title>Look without being seen</h2>
        <p class="lede">Check a story or read a message on your own time, without anyone knowing you saw it. Turn on only the ones you want.</p>
      </div>
      <div class="switches" data-reveal data-ghost>
        {ghost.map(([title, text], i) => (
          <div class="row">
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
            <button class="switch" type="button" role="switch" aria-checked={i !== 2 ? 'true' : 'false'} aria-label={title} data-switch></button>
          </div>
        ))}
      </div>
    </section>

    <section class="more wrap">
      <h2 data-title>And everything else you’d expect</h2>
      <dl class="list">
        {more.map(([title, text]) => (
          <div class="item" data-row>
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="privacy wrap">
      <div class="panel" data-reveal>
        <p class="label">Privacy</p>
        <h2>Your account stays between you and Instagram</h2>
        <ul>
          <li><strong>You sign in on Instagram’s own page</strong> Matte never sees your password.</li>
          <li><strong>Nothing goes to us</strong> No analytics, no tracking, no servers of our own. Matte talks to Instagram, and to GitHub to check for updates.</li>
          <li><strong>Your session stays on your Mac</strong> Sign out and it’s gone.</li>
        </ul>
        <a class="more-link" href="/privacy">What Matte keeps and sends, in full →</a>
      </div>
    </section>

    <section class="final">
      <div class="wrap center" data-reveal>
        <Wordmark height={84} />
        <p class="lede">Free for Macs with Apple silicon or Intel, on macOS 15 or later</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/download">Download for Mac</a>
          <Command command={brew} />
        </div>
      </div>
    </section>
  </main>

  <!-- The page's own mini player, like Matte's: a reel that keeps playing in the corner while
       you scroll, from the end of the hero until the Reels scene shows the real thing. -->
  <aside class="dock" data-dock aria-label="Mini player">
    <img src="/shots/reel.webp" alt="" width="384" height="683" />
    <span class="dock-bar"><b></b></span>
    <button class="dock-close" type="button" data-dock-close aria-label="Close the mini player">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </aside>
</Base>

<style>
  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Hero */
  .hero {
    padding-top: 152px;
  }

  .hero h1 {
    font-size: clamp(48px, 8.4vw, 108px);
  }

  .hero .lede {
    margin-top: 24px;
    max-width: 560px;
  }

  .ctas {
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .meta {
    margin-top: 20px;
    font-size: 14px;
    color: var(--ink-3);
  }

  /* The shot keeps room below the window for its shadow; pull the next section up into it. */
  .hero-shot {
    max-width: 1340px;
    margin-top: 40px;
    margin-bottom: -8%;
  }

  /* Reasons: three columns of text, icons and headings on one line each */
  .reasons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 0;
    padding-bottom: 96px;
  }

  .reason svg {
    color: var(--ink-2);
  }

  .reason h3 {
    margin-top: 16px;
    font-size: 20px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .reason p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 16px;
    text-wrap: wrap;
  }

  .label {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-3);
  }

  /* Features */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: center;
    gap: 24px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .feature.flip {
    grid-template-columns: minmax(0, 8fr) minmax(0, 5fr);
  }

  .feature.flip .copy {
    order: 2;
  }

  .copy h2,
  .more h2 {
    margin-top: 16px;
    font-size: clamp(36px, 4.4vw, 56px);
  }

  .copy .lede {
    margin-top: 20px;
  }

  /* The shots have room for the window's shadow; let it spill past the column. */
  .media {
    margin: 0 -7%;
  }

  /* The Reels scene: the Reels window, Home sliding in front, and the reel moving from its
     slot in the Reels window (26.1% across, 16% down, 26.7% wide of the 1440 × 1100 layer)
     to the corner (84%, 54.5%, 10.4% wide). */
  .pip {
    position: relative;
  }

  .pip img {
    width: 100%;
    height: auto;
  }

  .pip-other {
    position: absolute;
    inset: 0;
  }

  .pip-slot {
    position: absolute;
    left: 26.11%;
    top: 16%;
    width: 26.67%;
    aspect-ratio: 384 / 683;
    pointer-events: none;
  }

  .pip-reel {
    position: absolute;
    left: 84%;
    top: 54.5%;
    width: 10.42%;
    border-radius: 6px;
    overflow: hidden;
    transform-origin: 0 0;
    box-shadow: 0 0 0 1px var(--line-strong), 0 16px 40px rgba(0, 0, 0, 0.3);
  }

  .pip-reel img {
    display: block;
  }

  .pip-bar,
  .dock-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.25);
  }

  .pip-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform-origin: left;
    animation: play 12s linear infinite;
  }

  @keyframes play {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* The page's mini player */
  .dock {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    width: 120px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-strong), 0 16px 40px rgba(0, 0, 0, 0.3);
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    transition: opacity 400ms var(--ease), transform 400ms var(--ease);
  }

  .dock:global(.on) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .dock img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The playhead is the page's own scroll position. */
  .dock-bar b {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left;
  }

  .dock-close {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms var(--ease);
  }

  .dock:hover .dock-close,
  .dock-close:focus-visible {
    opacity: 1;
  }

  /* On a phone it would sit on the words you're reading. */
  @media (max-width: 700px) {
    .dock {
      display: none;
    }
  }

  /* Ghost mode */
  .ghost {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 80px;
    padding-top: 88px;
    padding-bottom: 112px;
  }

  .switches {
    display: grid;
    gap: 12px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .row div {
    flex: 1;
  }

  .row h3 {
    font-size: 18px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .row p {
    margin-top: 4px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .switch {
    position: relative;
    flex-shrink: 0;
    width: 52px;
    height: 32px;
    border: 0;
    border-radius: 16px;
    background: var(--line-strong);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 240ms var(--ease);
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-raised);
    transition: transform 240ms var(--ease), background-color 240ms var(--ease);
  }

  .switch[aria-checked='true'] {
    background: var(--switch-on);
  }

  .switch[aria-checked='true']::after {
    transform: translateX(20px);
    background: var(--switch-knob);
  }

  /* Everything else: a quiet two-column list */
  .more {
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .more h2 {
    max-width: 640px;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 64px;
    margin: 40px 0 0;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  dt {
    font-weight: 500;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* Privacy */
  .privacy {
    padding-bottom: 64px;
  }

  .panel {
    padding: clamp(32px, 6vw, 72px);
    border-radius: 20px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .panel h2 {
    margin-top: 16px;
    max-width: 760px;
    font-size: clamp(36px, 4.4vw, 56px);
  }

  .panel ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 44px;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .panel strong {
    display: block;
    margin-bottom: 8px;
    color: var(--ink);
    font-weight: 500;
  }

  .more-link {
    display: inline-block;
    margin-top: 40px;
    font-weight: 500;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: border-color 160ms var(--ease);
  }

  .more-link:hover {
    border-color: var(--ink);
  }

  /* Final call */
  .final {
    padding: 112px 0 96px;
  }

  .final .lede {
    margin-top: 20px;
  }

  .phone-note {
    display: none;
  }

  /* Phones: each window shows the part that matters at a size you can read, instead of the
     whole window shrunk down. --w is the shot's width as a % of the frame, --x and --y move
     it (in % of the frame's width), --ar is the frame's shape. */
  @media (max-width: 700px) {
    .crop {
      position: relative;
      overflow: hidden;
      aspect-ratio: var(--ar);
      margin: 0;
      border-radius: 16px;
      box-shadow: inset 0 0 0 1px var(--line);
    }

    .media.crop {
      margin: 0;
    }

    .crop > :global(*) {
      width: calc(var(--w) * 1%);
      max-width: none;
      margin-left: calc(var(--x) * -1%);
      margin-top: calc(var(--y) * -1%);
    }

    .hero {
      padding-top: 112px;
    }

    .hero-shot {
      margin-top: 32px;
      margin-bottom: 0;
    }

    .phone-note {
      display: block;
      margin-top: 8px;
      font-size: 14px;
      color: var(--ink-2);
    }

    .reasons {
      padding-top: 56px;
      padding-bottom: 32px;
    }

    .feature,
    .feature.flip,
    .ghost {
      gap: 24px;
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .more {
      padding-top: 40px;
      padding-bottom: 56px;
    }

    .final {
      padding: 72px 0 64px;
    }
  }

  @media (max-width: 900px) {
    .reasons,
    .list,
    .panel ul {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .list {
      gap: 0;
    }

    .item {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .feature,
    .feature.flip,
    .ghost {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .feature.flip .copy {
      order: 0;
    }

    .media {
      margin: 0 -10%;
    }
  }
</style>
