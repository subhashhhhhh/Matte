---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Command from '../components/Command.astro';
import Wordmark from '../components/Wordmark.astro';
import { brew } from '../data';

const reasons = [
  {
    title: 'Easy on your Mac',
    text: 'instagram.com in a browser often takes 4–5 GB of memory. Matte takes a fraction of that, so the rest of your Mac stays quick.',
    icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    title: 'Your phone can stay in your pocket',
    text: 'Messages, stories and Reels on the screen you’re already looking at, with a real keyboard to reply.',
    icon: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  },
  {
    title: 'Feels like a Mac app',
    text: 'Swipe carousels with the trackpad, double-click to like, and get notifications like any other app.',
    icon: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM2 20h20',
  },
];

const ghost = [
  ['Watch stories without “Seen”', 'Your name stays off the viewer list.'],
  ['Read messages without “Seen”', 'The chat stays unread for the sender.'],
  ['Type without “typing…”', 'Nobody sees you writing a reply.'],
];

const more = [
  ['Post from your Mac', 'Photos, carousels and reels, and a story editor with text, drawing, stickers, filters and music.', 'M12 5v14M5 12h14'],
  ['Every account, one window', 'Add your other accounts and switch between them in a click.', 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'],
  ['Saved, sorted', 'Your saved posts and collections, laid out to browse.', 'm19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z'],
  ['Explore and search', 'Find people, tags and places, with your recent searches kept.', 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.3-4.3'],
  ['Day or night', 'Light and dark mode, following your Mac.', 'M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z'],
  ['Free, for good', 'No ads, no subscription, no account with us. The code is open for anyone to read.', 'M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z'],
];
---

<Base
  title="Matte — Instagram for your Mac"
  description="Matte is a free Mac app for Instagram. Your feed, Reels, stories and DMs on the big screen, in an app that won’t slow your computer down."
>
  <main>
    <section class="hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap center">
        <p class="eyebrow pill" data-reveal>Free · For macOS 15 and later</p>
        <h1 data-reveal>Your Instagram,<br />on the big screen</h1>
        <p class="lede" data-reveal>Feed, Reels, stories and DMs in a Mac app that won’t slow your computer down.</p>
        <div class="ctas" data-reveal>
          <a class="btn btn-primary" href="/download">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.37 12.73c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.41-3.65zM14.1 5.98c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.75-.96 2.79 1.02.08 2.05-.52 2.68-1.27z"></path></svg>
            Download for Mac
          </a>
          <Command command={brew} />
        </div>
      </div>
      <div class="wrap hero-shot" data-reveal>
        <Shot name="home" eager alt="Matte’s home feed: posts in three columns, stories down the side, a reel playing in the corner and a message arriving" />
      </div>
    </section>

    <section class="reasons wrap" aria-label="Why Matte">
      {reasons.map((r) => (
        <div class="reason" data-reveal>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={r.icon}></path></svg>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </div>
      ))}
    </section>

    <div id="features"></div>

    <section class="feature wrap">
      <div class="copy" data-reveal>
        <p class="eyebrow">Messages</p>
        <h2>Answer DMs without reaching for your phone</h2>
        <p class="lede">Messages pop up on your Mac while you work. Reply with a real keyboard, send photos and videos straight from your computer, and keep the chats that matter pinned at the top.</p>
      </div>
      <div class="media" data-reveal>
        <Shot name="messages" alt="A conversation in Matte with a shared reel, a voice note and a reaction, and a new message notification" />
      </div>
    </section>

    <section class="feature flip wrap">
      <div class="copy" data-reveal>
        <p class="eyebrow">Reels</p>
        <h2>Reels on a screen big enough to enjoy them</h2>
        <p class="lede">Watch with the comments right beside the video. Go check something else and the reel keeps playing in the corner.</p>
      </div>
      <div class="media" data-reveal>
        <Shot name="reels" alt="A reel in Matte with its comments beside it, and another reel playing in the corner" />
      </div>
    </section>

    <section class="feature wrap">
      <div class="copy" data-reveal>
        <p class="eyebrow">For business and creator accounts</p>
        <h2>Post on time, even on your busiest days</h2>
        <p class="lede">Line up a month of posts and reels, and Instagram publishes each one on time, even with your Mac closed. Then answer every comment still waiting for you, from one list.</p>
      </div>
      <div class="media" data-reveal>
        <Shot name="planner" alt="Matte’s planner: a month of scheduled posts and reels, with the upcoming ones listed beside it" />
      </div>
    </section>

    <section class="ghost wrap">
      <div class="copy" data-reveal>
        <p class="eyebrow">Ghost mode</p>
        <h2>Look without being seen</h2>
        <p class="lede">Check a story or read a message on your own time, without anyone knowing you saw it. Turn on only the ones you want.</p>
      </div>
      <div class="switches" data-reveal>
        {ghost.map(([title, text], i) => (
          <div class="row">
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
            <button class="switch" type="button" role="switch" aria-checked={i !== 2 ? 'true' : 'false'} aria-label={title} data-switch></button>
          </div>
        ))}
      </div>
    </section>

    <section class="more wrap">
      <h2 data-reveal>And everything else you’d expect</h2>
      <div class="grid">
        {more.map(([title, text, icon]) => (
          <div class="card" data-reveal>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon}></path></svg>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="privacy wrap">
      <div class="panel" data-reveal>
        <p class="eyebrow">Privacy</p>
        <h2>Your account stays between you and Instagram</h2>
        <ul>
          <li><strong>You sign in on Instagram’s own page.</strong> Matte never sees your password.</li>
          <li><strong>Nothing goes to us.</strong> No analytics, no tracking, no servers of our own. Matte talks to Instagram, and to GitHub to check for updates.</li>
          <li><strong>Your session stays on your Mac.</strong> Sign out and it’s gone.</li>
        </ul>
        <a class="more-link" href="/privacy">What Matte keeps and sends, in full →</a>
      </div>
    </section>

    <section class="final">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap center" data-reveal>
        <Wordmark height={84} />
        <p class="lede">Free. For Macs with Apple silicon or Intel, on macOS 15 or later.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/download">Download for Mac</a>
          <Command command={brew} />
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Hero */
  .hero {
    position: relative;
    padding-top: 150px;
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 46% at 50% 66%, var(--glow-a), transparent 72%),
      radial-gradient(34% 34% at 86% 84%, var(--glow-b), transparent 70%),
      radial-gradient(30% 30% at 12% 70%, var(--glow-b), transparent 70%),
      radial-gradient(40% 30% at 50% 0%, var(--glow-c), transparent 70%);
  }

  .pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    letter-spacing: 0.04em;
  }

  .hero h1 {
    margin-top: 28px;
    font-size: clamp(48px, 8.4vw, 108px);
  }

  .hero .lede {
    margin-top: 26px;
    max-width: 560px;
  }

  .ctas {
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .hero-shot {
    max-width: 1340px;
    margin-top: 40px;
  }

  /* Reasons */
  .reasons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .reason h3,
  .card h3 {
    margin-top: 18px;
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .reason p,
  .card p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .reason svg,
  .card svg {
    color: var(--ink-2);
  }

  /* Features */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: center;
    gap: 24px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .feature.flip {
    grid-template-columns: minmax(0, 8fr) minmax(0, 5fr);
  }

  .feature.flip .copy {
    order: 2;
  }

  .copy h2,
  .more h2 {
    margin-top: 16px;
    font-size: clamp(38px, 4.6vw, 60px);
  }

  .copy .lede {
    margin-top: 22px;
  }

  /* The shots have room for the window's shadow; let it spill past the column. */
  .media {
    position: relative;
    margin: 0 -7%;
  }

  /* A little light behind each window. */
  .media::before {
    content: '';
    position: absolute;
    inset: 10% 8%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--glow-a), transparent);
    filter: blur(20px);
  }

  /* Ghost mode */
  .ghost {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 80px;
    padding-top: 90px;
    padding-bottom: 110px;
  }

  .switches {
    display: grid;
    gap: 14px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 22px 26px;
    border-radius: 22px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .row div {
    flex: 1;
  }

  .row h3 {
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .row p {
    margin-top: 4px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .switch {
    position: relative;
    flex-shrink: 0;
    width: 54px;
    height: 32px;
    border: 0;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    transition: background-color 260ms var(--ease);
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--bg-raised);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    transition: transform 260ms var(--ease), background-color 260ms var(--ease);
  }

  .switch[aria-checked='true'] {
    background: var(--switch-on);
  }

  .switch[aria-checked='true']::after {
    transform: translateX(22px);
    background: var(--switch-knob);
  }

  /* Everything else */
  .more {
    padding-top: 60px;
    padding-bottom: 100px;
  }

  .more h2 {
    max-width: 640px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .card {
    padding: 28px;
    border-radius: 24px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  /* Privacy */
  .privacy {
    padding-bottom: 60px;
  }

  .panel {
    padding: clamp(32px, 6vw, 72px);
    border-radius: 32px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow);
  }

  .panel h2 {
    margin-top: 16px;
    max-width: 760px;
    font-size: clamp(36px, 4.4vw, 56px);
  }

  .panel ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 44px;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .panel strong {
    display: block;
    margin-bottom: 8px;
    color: var(--ink);
    font-weight: 600;
  }

  .more-link {
    display: inline-block;
    margin-top: 40px;
    font-weight: 600;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }

  /* Final call */
  .final {
    position: relative;
    padding: 120px 0 100px;
  }

  .final .glow {
    background: radial-gradient(40% 50% at 50% 50%, var(--glow-a), transparent 70%);
  }

  .final .lede {
    margin-top: 22px;
  }

  @media (max-width: 900px) {
    .reasons,
    .grid,
    .panel ul {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .feature,
    .ghost {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .feature.flip {
      grid-template-columns: 1fr;
    }

    .feature.flip .copy {
      order: 0;
    }

    .media {
      margin: 0 -10%;
    }
  }
</style>
