---
// A page of reading: a header and prose, on the same paper or night as the home page.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro?: string;
  noindex?: boolean;
}
const { title, description, eyebrow, heading, intro, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <main class="doc">
    <div class="glow" aria-hidden="true"></div>
    <header class="wrap head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {intro && <p class="lede">{intro}</p>}
    </header>
    <div class="wrap body">
      <slot />
    </div>
  </main>
</Base>

<style>
  .doc {
    position: relative;
    padding-top: 150px;
    padding-bottom: 60px;
  }

  .glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 520px;
    z-index: -1;
    background: radial-gradient(50% 60% at 30% 20%, var(--glow-a), transparent 70%);
    pointer-events: none;
  }

  .head {
    max-width: calc(820px + 2 * var(--gutter));
  }

  h1 {
    margin-top: 18px;
    font-size: clamp(44px, 6vw, 76px);
  }

  .lede {
    margin-top: 22px;
  }

  .body {
    max-width: calc(820px + 2 * var(--gutter));
    margin-top: 56px;
  }

  .body :global(h2) {
    margin: 56px 0 16px;
    font-size: 30px;
    letter-spacing: -0.025em;
  }

  .body :global(h3) {
    margin: 32px 0 10px;
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--ink-2);
  }

  .body :global(p + p) {
    margin-top: 14px;
  }

  .body :global(ul),
  .body :global(ol) {
    display: grid;
    gap: 10px;
    margin: 14px 0;
    padding-left: 22px;
  }

  .body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(a:not(.btn)) {
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
  }

  .body :global(code) {
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--card-strong);
    color: var(--ink);
  }

  .body :global(table) {
    width: 100%;
    margin: 18px 0;
    border-collapse: collapse;
    font-size: 15px;
  }

  .body :global(th),
  .body :global(td) {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    color: var(--ink-2);
  }

  .body :global(th) {
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(.note) {
    margin-top: 28px;
    padding: 24px 26px;
    border-radius: 20px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
